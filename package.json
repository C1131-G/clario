{
  "name": "clario",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "ultracite fix",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "quality:fallow": "fallow audit || exit 0",
    "quality:fallow:audit": "fallow audit || exit 0",
    "quality:fallow:full": "fallow",
    "quality:react": "react-doctor --no-supply-chain --blocking none",
    "quality:shadscan": "shadscan --no-interactive --no-roast",
    "quality": "bun run lint && bun run typecheck && bun run quality:fallow && (bun run quality:react || exit 0) && (bun run quality:shadscan || exit 0)",
    "prepare": "lefthook install",
    "doctor": "npx react-doctor@latest",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:bootstrap": "bun run scripts/bootstrap.ts",
    "openapi:validate": "bun run test -- tests/openapi.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/memory-adapter": "^1.7.2",
    "@phosphor-icons/react": "^2.1.10",
    "@sap/hana-client": "^2.29.27",
    "@shadcn/react": "^0.3.0",
    "@tanstack/ai": "0.52.0",
    "@tanstack/ai-persistence": "0.5.4",
    "@tanstack/ai-react": "0.22.4",
    "@tanstack/charts": "0.14.0",
    "@tanstack/react-charts": "0.14.0",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-scale": "4.0.2",
    "lucide-react": "^1.37.0",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4",
    "zod-openapi": "^6.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@shadscan/cli": "0.17.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "fallow": "3.17.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-plugin-react-doctor": "^0.9.12",
    "pino-pretty": "^13.1.3",
    "react-doctor": "0.9.12",
    "typescript": "^5",
    "ultracite": "7.10.6",
    "vitest": "^4.1.11"
  }
}
